# Vaari production settings. Copy to .env and fill in. Never commit .env.
VAARI_ENV=production

# REQUIRED: at least 32 random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VAARI_SECRET_KEY=

VAARI_SESSION_HOURS=12
VAARI_TZ=Asia/Kolkata

# The centre
VAARI_CENTRE_NAME=
VAARI_CENTRE_PHONE=
VAARI_CENTRE_LAT=
VAARI_CENTRE_LON=

# The HTTPS address people open, used to build full driver and record links
VAARI_PUBLIC_BASE_URL=https://vaari.example.org

# Set true only when a reverse proxy you run sets X-Forwarded-For
VAARI_TRUST_PROXY=false

# Links
VAARI_DRIVER_LINK_DAYS=30
VAARI_RECORD_LINK_DAYS=365

# Register reader: mock is refused in production (it invents rows), so leave the reader
# off and staff type the rows beside the photo. The hosted (Gemini) reader is DEMO ONLY.
VAARI_READER=mock
VAARI_ALLOW_HOSTED_READER=false
VAARI_ALLOW_HOSTED_READER_IN_PRODUCTION=false

# Same origin only
VAARI_CORS_ORIGINS=

# Notifications (docs/NOTIFICATIONS.md)
# simulate (records, sends nothing) | live (sends through the providers below) | off
VAARI_NOTIFY_MODE=simulate
# Order to try, e.g. whatsapp,sms
VAARI_FARMER_CHANNELS=sms
VAARI_FARMER_QUIET_HOURS=21-7
# log | twilio | msg91
VAARI_SMS_PROVIDER=log
VAARI_TWILIO_ACCOUNT_SID=
VAARI_TWILIO_AUTH_TOKEN=
VAARI_TWILIO_FROM=
VAARI_TWILIO_MESSAGING_SERVICE_SID=
VAARI_MSG91_AUTH_KEY=
# JSON: message kind -> DLT-approved flow template id
VAARI_MSG91_TEMPLATES=
# log | cloud
VAARI_WHATSAPP_PROVIDER=log
VAARI_WHATSAPP_TOKEN=
VAARI_WHATSAPP_PHONE_NUMBER_ID=
# JSON: message kind -> approved template name
VAARI_WHATSAPP_TEMPLATES=
# Web push: python tasks.py vapid-keys. Keep the private key secret; changing keys turns alerts off on every device.
VAARI_VAPID_PUBLIC_KEY=
VAARI_VAPID_PRIVATE_KEY=
VAARI_VAPID_SUBJECT=mailto:you@example.org
VAARI_DRIVER_DIGEST_HOUR=6
